# HATCH mini-PC stream config. Copy to stream.env and fill in STREAM_KEY.
# stream.env is gitignored — it holds your secret stream key.

# ── REQUIRED: your Twitch stream key ──
# Twitch → Creator Dashboard → Settings → Stream → "Primary Stream key" → Copy.
STREAM_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Video (defaults tuned for low-motion pixel art) ──
WIDTH=1280
HEIGHT=720
FPS=30
BITRATE=2500k

# ── Encoder ──
#   vaapi    = Intel hardware H.264 via /dev/dri (BEST on N100 — cool + efficient) [default]
#   qsv      = Intel Quick Sync (alt hardware path; try if vaapi misbehaves)
#   software = libx264 on CPU (always works; fine for pixel art if HW ever fails)
ENCODER=vaapi
# Intel render node (almost always renderD128; change only if vainfo points elsewhere)
VAAPI_DEVICE=/dev/dri/renderD128

# ── What we capture. music=0 keeps it silent (we send a silent audio track to
#    satisfy Twitch). Audio capture is an optional later upgrade. ──
OVERLAY_URL=http://localhost:8787/overlay.html?music=0

# ── Twitch ingest. Default auto-routes to your nearest server; leave as-is. ──
INGEST=rtmp://live.twitch.tv/app

# ── Internal (rarely changed) ──
DISPLAY_NUM=99
