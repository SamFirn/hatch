# HATCH Pi stream config. Copy to stream.env and fill in STREAM_KEY.
# stream.env is gitignored — it holds your secret stream key.

# ── REQUIRED: your Twitch stream key ──
# Twitch → Creator Dashboard → Settings → Stream → "Primary Stream key" → Copy.
STREAM_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Video (defaults are tuned for low-motion pixel art) ──
WIDTH=1280
HEIGHT=720
FPS=30
BITRATE=2500k

# ── Encoder: software (most reliable everywhere) | hardware (Pi 4 HW H.264) ──
# Start on software. Once live and stable, try hardware to cut CPU/heat, then
# eyeball the stream for artifacts. If it looks worse, switch back to software.
ENCODER=software

# ── What we capture. music=0 keeps it silent (we send a silent audio track to
#    satisfy Twitch). Audio capture is an optional later upgrade. ──
OVERLAY_URL=http://localhost:8787/overlay.html?music=0

# ── Twitch ingest. Default auto-routes to your nearest server; leave as-is. ──
INGEST=rtmp://live.twitch.tv/app

# ── Internal (rarely changed) ──
DISPLAY_NUM=99
